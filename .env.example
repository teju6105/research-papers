# Copy this file to .env for local development. Replace placeholders
# locally; never commit real credentials.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/research_papers"
SHADOW_DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/research_papers_shadow"
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
MONGODB_URI="mongodb+srv://USER:PASSWORD@HOST/research_papers?retryWrites=true&w=majority"
MONGODB_DATABASE="research_papers"
CHROMA_PERSIST_DIRECTORY="./data/chroma"
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
VECTOR_API_URL="http://127.0.0.1:8000"
